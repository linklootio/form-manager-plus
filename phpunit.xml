<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="Tests/Bootstrap.php" colors="true" failOnWarning="true" failOnRisky="true" failOnDeprecation="true" cacheDirectory=".phpunit.cache">
 <testsuites>
  <testsuite name="unit"><directory suffix="Test.php">Tests/Unit</directory></testsuite>
